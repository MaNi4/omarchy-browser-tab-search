{
  "manifest_version": 3,
  "name": "Omarchy Browser Tab Search",
  "version": "1.0.0",
  "description": "Lets Omarchy's Browser Tab Search find your open tabs, recently closed tabs, bookmarks and history, and switch to the one you pick.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "favicon",
    "alarms",
    "bookmarks",
    "history",
    "sessions",
    "search"
  ],
  "background": {
    "service_worker": "worker-1.js"
  },
  "icons": {
    "128": "icon.png"
  }
}
